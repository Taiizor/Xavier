{
  "Xavier": {
    "RateLimiting": {
      "Enabled": true,
      "EnableGlobalPolicy": true,
      "EnablePerIpPolicy": true,
      "EnablePerClientPolicy": true,
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0,
      "AddRateLimitHeaders": true
    },
    "Health": {
      "Enabled": true
    },
    "Correlation": {
      "Enabled": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
