{
    "Xavier": {
        "Correlation": {
            "Enabled": true,
            "HeaderName": "X-Correlation-Id"
        },
        "ErrorHandling": {
            "Enabled": true,
            "IncludeExceptionDetails": false,
            "IncludeTraceId": true,
            "IncludeCorrelationId": true
        },
        "HttpLogging": {
            "Enabled": false
        },
        "RateLimiting": {
            "Enabled": false
        },
        "OpenApi": {
            "Enabled": true,
            "DocumentName": "v1",
            "ExposeInNonDevelopment": false
        },
        "Health": {
            "Enabled": true,
            "LivenessPath": "/health",
            "ReadinessPath": "/ready"
        },
        "Observability": {
            "Enabled": false
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    }
}
