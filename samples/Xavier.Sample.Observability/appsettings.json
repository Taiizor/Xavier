{
  "Xavier": {
    "Observability": {
      "Enabled": true,
      "ServiceName": "Xavier.Sample.Observability",
      "ServiceVersion": "1.0.0",
      "EnableTracing": true,
      "EnableMetrics": true,
      "EnableRuntimeMetrics": true
    },
    "Health": {
      "Enabled": true
    },
    "Correlation": {
      "Enabled": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
