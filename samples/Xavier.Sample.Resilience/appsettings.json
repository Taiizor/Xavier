{
  "Xavier": {
    "Resilience": {
      "Enabled": true,
      "UseStandardResilience": true,
      "MaxRetryAttempts": 3,
      "TimeoutSeconds": 30
    },
    "Health": {
      "Enabled": true
    },
    "Correlation": {
      "Enabled": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Polly": "Information"
    }
  }
}
