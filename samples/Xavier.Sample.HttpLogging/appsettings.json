{
  "Xavier": {
    "HttpLogging": {
      "Enabled": true,
      "LogRequestHeaders": true,
      "LogResponseHeaders": true,
      "LogRequestBody": true,
      "LogResponseBody": true,
      "RequestBodyLogLimit": 4096,
      "ResponseBodyLogLimit": 4096
    },
    "Health": {
      "Enabled": true
    },
    "Correlation": {
      "Enabled": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.HttpLogging": "Information"
    }
  }
}
