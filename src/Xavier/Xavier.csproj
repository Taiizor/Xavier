<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>Xavier</RootNamespace>
        <AssemblyName>Xavier</AssemblyName>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- NuGet Package Metadata -->
    <PropertyGroup>
        <PackageId>Xavier</PackageId>
        <Title>Xavier - API Defaults Pack for ASP.NET Core</Title>
        <Description>Opinionated but customizable API defaults pack for ASP.NET Core. Provides one-liner setup for ProblemDetails, correlation IDs, health endpoints, HTTP logging, rate limiting, OpenAPI, resilience, and observability.</Description>
        <PackageTags>aspnetcore;api;defaults;problemdetails;correlation;health;openapi;ratelimit;resilience;observability</PackageTags>
        <PackageReadmeFile>README.NUGET.md</PackageReadmeFile>
        <PackageIcon>Logo.png</PackageIcon>
    </PropertyGroup>

    <!-- Pack README.NUGET.md -->
    <ItemGroup>
        <None Include="../../README.NUGET.md" Pack="true" PackagePath="/" />
        <None Include="../../.images/Logo.png" Pack="true" PackagePath="/" />
    </ItemGroup>

    <!-- Framework-specific dependencies -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <!-- Common dependencies -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
        <PackageReference Include="Microsoft.Extensions.Http" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    </ItemGroup>

    <!-- net8.0+ resilience -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0' Or '$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    </ItemGroup>

    <!-- OpenTelemetry (always available, but opt-in at runtime) -->
    <!-- Note: OTLP exporter is NOT included - consumers must add it themselves -->
    <ItemGroup>
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    </ItemGroup>

    <!-- SourceLink for debugging -->
    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    </ItemGroup>

    <!-- Testing -->
    <ItemGroup>
        <InternalsVisibleTo Include="Xavier.Tests" />
        <InternalsVisibleTo Include="Xavier.IntegrationTests" />
    </ItemGroup>

</Project>
